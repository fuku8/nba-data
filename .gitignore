# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# CSV配布（prebuild で data/*.csv をコピー）
/public/data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees
.worktrees/

# internal docs
docs/

# runtime logs
logs/

# Python
__pycache__/

# fetch-nba-data.py の名簿保存の一時ファイル（保存に失敗すると残る。日次の git add data/ に入れない）
/data/*.tmp
